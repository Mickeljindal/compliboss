# =============================================================================
# CompliBoss — production environment template
# =============================================================================
# Copy the relevant sections into each service's env file (see DEPLOYMENT.md):
#   - apps/api/.env      (the NestJS API — auth + business logic)
#   - apps/app/.env      (main dashboard)
#   - apps/portal/.env   (employee/trust portal)
# Generate secrets with:  openssl rand -base64 32
# Replace compliboss.com with your real domain everywhere.
# =============================================================================

# ---------------------------------------------------------------------------
# CORE SECRETS (required) — must MATCH across api/app/portal where shared
# ---------------------------------------------------------------------------
AUTH_SECRET=                 # openssl rand -base64 32  (better-auth signing)
SECRET_KEY=                  # openssl rand -base64 32  (data encryption)
REVALIDATION_SECRET=         # openssl rand -base64 32  (Next revalidation)
INTERNAL_API_TOKEN=          # openssl rand -base64 32  (app/portal <-> api)
SERVICE_TOKEN_TRIGGER=       # openssl rand -base64 32  (Trigger.dev -> api)
SERVICE_TOKEN_PORTAL=        # openssl rand -base64 32  (portal -> api)

# ---------------------------------------------------------------------------
# DATABASE (required) — Postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://compliboss:CHANGE_ME@postgres:5432/compliboss

# ---------------------------------------------------------------------------
# DOMAINS (required) — replace with your real domain
# ---------------------------------------------------------------------------
# API (apps/api/.env)
BASE_URL=https://api.compliboss.com
NEXT_PUBLIC_APP_URL=https://app.compliboss.com
PORT=3333
# Cross-subdomain session cookies + trusted origins (added for self-hosting)
COOKIE_DOMAIN=.compliboss.com
PUBLIC_ROOT_DOMAIN=compliboss.com
AUTH_TRUSTED_ORIGINS=https://app.compliboss.com,https://portal.compliboss.com,https://api.compliboss.com

# App (apps/app/.env)
BETTER_AUTH_URL=https://app.compliboss.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://app.compliboss.com
NEXT_PUBLIC_API_URL=https://api.compliboss.com
NEXT_PUBLIC_PORTAL_URL=https://portal.compliboss.com
NEXT_OUTPUT_STANDALONE=true

# Portal (apps/portal/.env)
# BETTER_AUTH_URL=https://portal.compliboss.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://portal.compliboss.com
# NEXT_PUBLIC_API_URL=https://api.compliboss.com

# ---------------------------------------------------------------------------
# FILE STORAGE (required) — pick ONE option
# ---------------------------------------------------------------------------
# OPTION A (recommended for a full self-hosted deploy): MinIO — S3-compatible
# object storage running on your own server (see docker-compose.prod.yml).
# Works for BOTH the API and the web apps with zero code changes, and switching
# to real AWS S3 later is just an env change. Set these on api/app/portal:
MINIO_ROOT_USER=compliboss
MINIO_ROOT_PASSWORD=change_me_min_8_chars
APP_AWS_ENDPOINT=http://minio:9000        # MinIO S3 endpoint (in-compose hostname)
APP_AWS_REGION=us-east-1
APP_AWS_ACCESS_KEY_ID=compliboss          # = MINIO_ROOT_USER
APP_AWS_SECRET_ACCESS_KEY=change_me_min_8_chars  # = MINIO_ROOT_PASSWORD
APP_AWS_BUCKET_NAME=compliboss-uploads
APP_AWS_ORG_ASSETS_BUCKET=compliboss-org-assets
APP_AWS_KNOWLEDGE_BASE_BUCKET=compliboss-knowledge-base
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET=compliboss-questionnaire
# Leave STORAGE_DRIVER unset (or "s3") when using MinIO/S3.

# OPTION B (API-only local disk, no object store): files on the API server's
# disk. NOTE: the web apps' own upload/logo features need the API or MinIO —
# this covers the API's upload/evidence/policy flows. LOCAL_STORAGE_DIR must be
# a PERSISTENT volume or uploads are lost on redeploy.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=/var/lib/compliboss/uploads
# LOCAL_STORAGE_UPLOAD_SECRET=            # optional; falls back to AUTH_SECRET

# ---------------------------------------------------------------------------
# EMAIL (required for invites/login) — Resend
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_DOMAIN=mail.compliboss.com
RESEND_FROM_SYSTEM=noreply@mail.compliboss.com
RESEND_FROM_DEFAULT=hello@mail.compliboss.com
RESEND_FROM_TRUST_PORTAL=noreply@mail.compliboss.com

# ---------------------------------------------------------------------------
# AI (required for policy/vendor/risk generation + chat)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=          # optional, more model options
# GROQ_API_KEY=               # optional, dashboard AI chat

# ---------------------------------------------------------------------------
# OPTIONAL — features degrade gracefully if unset
# ---------------------------------------------------------------------------
# Background jobs (evidence automation, notifications). Without it, async
# jobs won't run. Self-host or use https://trigger.dev
# TRIGGER_SECRET_KEY=
# Rate limiting + KV (Upstash Redis REST). Free tier works.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Knowledge-base vector search (Upstash Vector)
# UPSTASH_VECTOR_REST_URL=
# UPSTASH_VECTOR_REST_TOKEN=
# Vendor research
# FIRECRAWL_API_KEY=
# SSO logins
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
